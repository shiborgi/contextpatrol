{
  "name": "contextpatrol",
  "version": "1.0.0",
  "description": "Deterministic, read-only code context analysis for software agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiborgi/contextpatrol.git"
  },
  "homepage": "https://github.com/shiborgi/contextpatrol#readme",
  "bugs": {
    "url": "https://github.com/shiborgi/contextpatrol/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "contextpatrol": "./bin/contextpatrol.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/test/",
    "schemas/",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test:run": "node --test dist/test/*.test.js",
    "test": "npm run build && npm run test:run",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:run",
    "smoke:run": "node scripts/smoke.mjs",
    "smoke": "npm run build && npm run smoke:run",
    "smoke:installed": "node scripts/package-smoke.mjs",
    "cli-check:run": "node bin/contextpatrol.js --help",
    "cli-check": "npm run build && npm run cli-check:run",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:run && npm run smoke:run && npm run cli-check:run",
    "release-check": "npm run build && npm run smoke:installed",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "web-tree-sitter": "^0.26.13",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^24.13.3"
  },
  "keywords": [
    "agents",
    "code-analysis",
    "context-engineering",
    "static-analysis"
  ]
}
