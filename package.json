{
  "name": "contextpatrol",
  "version": "1.0.0",
  "description": "Deterministic, read-only code context analysis for software agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiborgi/contextpatrol.git"
  },
  "homepage": "https://github.com/shiborgi/contextpatrol#readme",
  "bugs": {
    "url": "https://github.com/shiborgi/contextpatrol/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "contextpatrol": "./bin/contextpatrol.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/test/",
    "schemas/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test dist/test/*.test.js",
    "check": "node dist/src/cli.js info",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run check",
    "release-check": "npm run verify && node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "web-tree-sitter": "^0.26.13",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^24.13.3",
    "eslint": "^10.0.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.41.0"
  },
  "keywords": [
    "agents",
    "code-analysis",
    "context-engineering",
    "static-analysis"
  ]
}
