{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contextpatrol:query-response:1.0",
  "title": "Context Query 1.0 Response",
  "type": "object", "additionalProperties": false,
  "required": ["protocolVersion", "profile", "snapshot", "signals", "files", "graph", "diagnostics", "stats", "digest"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "profile": { "enum": ["overview", "architecture", "implementation", "review"] },
    "snapshot": { "$ref": "#/$defs/hash" },
    "digest": { "$ref": "#/$defs/hash" },
    "signals": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "files": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "language", "score", "reasons"],
        "properties": {
          "path": { "$ref": "#/$defs/path" }, "language": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0 },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "excerpt": { "type": "string" }
        }
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "edges", "cycles", "impacted"],
      "properties": {
        "nodes": { "$ref": "#/$defs/paths" },
        "edges": { "type": "array", "uniqueItems": true, "maxItems": 20000, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "to", "kind"],
          "properties": { "from": { "$ref": "#/$defs/path" }, "to": { "$ref": "#/$defs/path" }, "kind": { "const": "imports" } }
        } },
        "cycles": { "type": "array", "maxItems": 100, "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/path" } } },
        "impacted": { "$ref": "#/$defs/paths" }
      }
    },
    "diagnostics": { "type": "array", "maxItems": 102, "items": { "type": "string" } },
    "stats": {
      "type": "object", "additionalProperties": false, "required": ["scannedFiles", "selectedFiles", "truncated"],
      "properties": {
        "scannedFiles": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "selectedFiles": { "type": "integer", "minimum": 0, "maximum": 500 },
        "truncated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:*?\\[\\]{}\\u0000-\\u001f\\u007f]).*[^/]$" },
    "paths": { "type": "array", "uniqueItems": true, "maxItems": 500, "items": { "$ref": "#/$defs/path" } }
  }
}
