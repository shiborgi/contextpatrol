{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiborgi.dev/contextpatrol/capsule.schema.json",
  "title": "Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "capsuleId",
    "capsuleDigest",
    "requestDigest",
    "intent",
    "focus",
    "snapshot",
    "budget",
    "changedPaths",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "capsuleId": { "type": "string" },
    "capsuleDigest": { "type": "string" },
    "requestDigest": { "type": "string" },
    "intent": { "type": "string" },
    "focus": {
      "type": "array",
      "items": { "enum": ["architecture", "symbols", "source"] }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "workspaceId",
        "head",
        "dirtyDigest",
        "sourceDigest",
        "snapshotDigest",
        "extractorVersion",
        "policyDigest"
      ],
      "properties": {
        "projectId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "head": { "type": "string" },
        "dirtyDigest": { "type": "string" },
        "sourceDigest": { "type": "string" },
        "snapshotDigest": { "type": "string" },
        "extractorVersion": { "type": "string" },
        "policyDigest": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedTokens", "estimatedTokens", "estimator"],
      "properties": {
        "requestedTokens": { "type": "integer", "exclusiveMinimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 },
        "estimator": { "const": "utf8-bytes/3-conservative-v1" }
      }
    },
    "changedPaths": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "text", "provenance", "confidence", "estimatedTokens"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["architecture", "symbol", "source"] },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "path": { "type": "string" },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startLine", "endLine"],
            "properties": {
              "startLine": { "type": "integer", "exclusiveMinimum": 0 },
              "endLine": { "type": "integer", "exclusiveMinimum": 0 }
            }
          },
          "provenance": { "enum": ["extracted", "heuristic"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "estimatedTokens": { "type": "integer", "minimum": 0 },
          "clipped": { "type": "boolean" }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "enum": ["token-budget"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
