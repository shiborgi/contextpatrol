{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiborgi.dev/contextpatrol/capsule.schema.json",
  "title": "Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "capsuleId",
    "capsuleDigest",
    "requestDigest",
    "intent",
    "focus",
    "snapshot",
    "budget",
    "changedPaths",
    "evidence",
    "sections",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "capsuleId": { "type": "string" },
    "capsuleDigest": { "type": "string" },
    "requestDigest": { "type": "string" },
    "intent": { "type": "string" },
    "focus": {
      "type": "array",
      "items": { "enum": ["architecture", "symbols", "source", "graph", "review"] }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "workspaceId",
        "head",
        "dirtyDigest",
        "sourceDigest",
        "snapshotDigest",
        "extractorVersion",
        "policyDigest"
      ],
      "properties": {
        "projectId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "head": { "type": "string" },
        "dirtyDigest": { "type": "string" },
        "sourceDigest": { "type": "string" },
        "snapshotDigest": { "type": "string" },
        "extractorVersion": { "type": "string" },
        "policyDigest": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedTokens", "estimatedTokens", "estimator"],
      "properties": {
        "requestedTokens": { "type": "integer", "exclusiveMinimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 },
        "estimator": { "const": "utf8-bytes/3-conservative-v1" }
      }
    },
    "changedPaths": { "type": "array", "items": { "type": "string" } },
    "includePaths": { "type": "array", "items": { "type": "string" } },
    "excludePaths": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "text", "provenance", "confidence", "estimatedTokens"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["architecture", "symbol", "source"] },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "path": { "type": "string" },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startLine", "endLine"],
            "properties": {
              "startLine": { "type": "integer", "exclusiveMinimum": 0 },
              "endLine": { "type": "integer", "exclusiveMinimum": 0 }
            }
          },
          "provenance": { "enum": ["extracted", "heuristic"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "estimatedTokens": { "type": "integer", "minimum": 0 },
          "clipped": { "type": "boolean" }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage"],
      "properties": {
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileCount", "symbolCount", "edgeCount", "godSymbols", "boundaryFiles"],
          "properties": {
            "fileCount": { "type": "integer", "minimum": 0 },
            "symbolCount": { "type": "integer", "minimum": 0 },
            "edgeCount": { "type": "integer", "minimum": 0 },
            "godSymbols": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["qualifiedName", "score"],
                "properties": {
                  "qualifiedName": { "type": "string" },
                  "score": { "type": "number" }
                }
              }
            },
            "boundaryFiles": { "type": "array", "items": { "type": "string" } },
            "communities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "memberCount", "topFiles", "cohesion"],
                "properties": {
                  "id": { "type": "string" },
                  "memberCount": { "type": "integer", "minimum": 0 },
                  "topFiles": { "type": "array", "items": { "type": "string" } },
                  "cohesion": { "type": "number" }
                }
              }
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "method", "path", "handler"],
                "properties": {
                  "id": { "type": "string" },
                  "method": { "type": "string" },
                  "path": { "type": "string" },
                  "handler": { "type": ["string", "null"] }
                }
              }
            },
            "deadCode": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["qualifiedName", "confidence"],
                "properties": {
                  "qualifiedName": { "type": "string" },
                  "confidence": { "type": "number" }
                }
              }
            },
            "surprises": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "score", "reasons"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "score": { "type": "number" },
                  "reasons": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "nodeId"],
                "properties": {
                  "text": { "type": "string" },
                  "nodeId": { "type": "string" }
                }
              }
            },
            "outlines": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "symbols"],
                "properties": {
                  "path": { "type": "string" },
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["qualifiedName", "kind", "exported"],
                      "properties": {
                        "qualifiedName": { "type": "string" },
                        "kind": { "type": "string" },
                        "exported": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            },
            "referenceCensus": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["qualifiedName", "incomingCalls"],
                "properties": {
                  "qualifiedName": { "type": "string" },
                  "incomingCalls": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "nodeIds"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "nodeIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changedSymbols", "risk", "impact", "testGaps"],
          "properties": {
            "changedSymbols": { "type": "array", "items": { "type": "string" } },
            "risk": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["qualifiedName", "totalRisk", "factors"],
                "properties": {
                  "qualifiedName": { "type": "string" },
                  "totalRisk": { "type": "number" },
                  "factors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["factor", "raw", "capped", "contribution"],
                      "properties": {
                        "factor": { "type": "string" },
                        "raw": { "type": "number" },
                        "capped": { "type": "number" },
                        "contribution": { "type": "number" }
                      }
                    }
                  }
                }
              }
            },
            "impact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["direct", "transitive"],
              "properties": {
                "direct": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "score"],
                    "properties": { "id": { "type": "string" }, "score": { "type": "number" } }
                  }
                },
                "transitive": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "score"],
                    "properties": { "id": { "type": "string" }, "score": { "type": "number" } }
                  }
                }
              }
            },
            "testGaps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unresolvedCalls", "skipped", "truncated", "languagesSeen", "historyWindow"],
          "properties": {
            "unresolvedCalls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["callerQualifiedName", "count"],
                "properties": {
                  "callerQualifiedName": { "type": "string" },
                  "count": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "reason"],
                "properties": { "path": { "type": "string" }, "reason": { "type": "string" } }
              }
            },
            "truncated": { "type": "boolean" },
            "languagesSeen": { "type": "array", "items": { "type": "string" } },
            "historyWindow": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "enum": ["token-budget"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
