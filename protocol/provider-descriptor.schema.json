{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiborgi.dev/contextpatrol/provider-descriptor.schema.json",
  "title": "ProviderDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "protocolVersion", "supportedProtocolVersions", "features", "focusValues", "estimator", "limits", "optionalRequestFields"],
  "properties": {
    "provider": { "const": "contextpatrol" },
    "protocolVersion": { "const": 1 },
    "supportedProtocolVersions": { "type": "array", "const": [1] },
    "features": { "type": "array", "items": { "const": "pack" } },
    "focusValues": {
      "type": "array",
      "items": { "enum": ["architecture", "symbols", "source", "graph", "review"] }
    },
    "estimator": { "const": "cl100k_base@1.0.0" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minBudget", "maxBudget", "maxRequestBytes", "maxChangedPaths", "maxFileBytes", "maxFiles"],
      "properties": {
        "minBudget": { "const": 128 },
        "maxBudget": { "type": "integer" },
        "maxRequestBytes": { "type": "integer" },
        "maxChangedPaths": { "type": "integer" },
        "maxFileBytes": { "type": "integer" },
        "maxFiles": { "type": "integer" }
      }
    },
    "optionalRequestFields": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
