{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiborgi.dev/contextpatrol/pack-request.schema.json",
  "title": "PackRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "intent", "focus", "tokenBudget"],
  "properties": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "focus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "enum": ["architecture", "symbols", "source", "graph", "review"] }
    },
    "tokenBudget": { "type": "integer", "minimum": 1, "maximum": 32000 },
    "changedPaths": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1 }
    },
    "gitRef": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "minLength": 1 },
    "includePaths": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1 }
    },
    "excludePaths": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
